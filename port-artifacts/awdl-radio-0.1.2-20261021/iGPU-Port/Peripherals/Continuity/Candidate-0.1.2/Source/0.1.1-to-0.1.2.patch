+void ItlIwx::latitudeAWDLStatus(LatitudeAWDLRadio::Status &out)
+{
+    out={};auto sc=&com;auto ic=&sc->sc_ic;auto ifp=&ic->ic_if;
+    out.device=sc->sc_pcitag->configRead16(kIOPCIConfigDeviceID);
+    if(out.device==0x7e40&&!strcmp(sc->sc_fwname,"iwlwifi-ma-b0-gf-a0-83.ucode"))out.flags|=LatitudeAWDLRadio::ExactHardware;
+    if((ifp->if_flags&IFF_RUNNING)&&(ifp->if_flags&IFF_UP)&&ic->ic_state==IEEE80211_S_RUN&&ic->ic_bss&&ic->ic_bss->ni_chan&&ic->ic_bss->ni_chan!=IEEE80211_CHAN_ANYC){
+        out.flags|=LatitudeAWDLRadio::Associated;out.frequency=ic->ic_bss->ni_chan->ic_freq;
+    }
+    int arm=0;if(PE_parse_boot_argn("latitude-awdl-current-channel",&arm,sizeof(arm))&&arm==1)out.flags|=LatitudeAWDLRadio::TransmitArmed;
+    memcpy(out.mac,ic->ic_myaddr,6);
+    out.submitted=latitudeAWDLTx.submitted;out.responses=latitudeAWDLTx.responses;
+    out.firmwareSuccess=latitudeAWDLTx.succeeded;out.firmwareFailure=latitudeAWDLTx.failed;
+    out.reclaimed=latitudeAWDLTx.reclaimed;out.aborted=latitudeAWDLTx.aborted;
+    out.missingResponse=latitudeAWDLTx.missingResponse;out.lastCookie=latitudeAWDLTx.lastCookie;out.lastStatus=latitudeAWDLTx.lastStatus;
+    out.received=latitudeAWDLReceiveQueue.received;out.dropped=latitudeAWDLReceiveQueue.dropped;out.queued=latitudeAWDLReceiveQueue.count;
+}
+void ItlIwx::latitudeAWDLCapture(struct iwx_softc *sc,mbuf_t m,int channel,int rssi)
+{
+    // Do not change firmware receive filters or expose ordinary Wi-Fi payloads.
+    if(!m||channel<0||channel>=(int)nitems(sc->sc_ic.ic_channels))return;
+    size_t length=mbuf_pkthdr_len(m);if(length<40||length>LatitudeAWDLRadio::MaxFrame)return;
+    uint8_t header[40];if(mbuf_copydata(m,0,sizeof(header),header))return;
+    if(header[0]!=0xd0||header[24]!=0x7f||header[25]!=0||header[26]!=0x17||header[27]!=0xf2||header[28]!=8)return;
+    uint8_t frame[LatitudeAWDLRadio::MaxFrame];if(mbuf_copydata(m,0,length,frame)||!LatitudeAWDLRadio::incoming(frame,length,sc->sc_ic.ic_myaddr))return;
+    uint64_t latitudeTicks=0,ns=0;clock_get_uptime(&latitudeTicks);absolutetime_to_nanoseconds(latitudeTicks,&ns);
+    latitudeAWDLReceiveQueue.push(frame,length,sc->sc_ic.ic_channels[channel].ic_freq,rssi,ns);
+}
