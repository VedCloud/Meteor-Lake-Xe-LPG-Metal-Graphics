            If ((Arg2 == 0x03)){}
            If ((Arg2 == 0x04)){}
            If ((Arg2 == 0x05)){}
            If ((Arg2 == 0x06))
            {
                If (CondRefOf (RDF6))
                {
                    Local0 = RDF6 /* External reference */
                    Return (Local0)
                }
                Else
                {
                    Return (Zero)
                }
            }

            Return (Zero)
        }

        Method (RDSM, 1, Serialized)
