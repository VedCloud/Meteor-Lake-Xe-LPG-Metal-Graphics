                    }
                    Else
                    {
                        ^^PPMC.DCWA = Arg1
                        WTTR |= 0x02 /* \_SB_.PC02.AWAC.WTTR */
                    }

                    Return (Zero)
                }

                Method (_TIP, 1, NotSerialized)  // _TIP: Expired Timer Wake Policy
                {
                    If ((Arg0 == Zero))
                    {
