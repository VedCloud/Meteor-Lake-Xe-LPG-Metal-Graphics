                Name (OBUF, Buffer (0x06){})
                CreateByteField (OBUF, Zero, OB00)
                CreateByteField (OBUF, One, OB01)
                CreateByteField (OBUF, 0x02, OB02)
                CreateByteField (OBUF, 0x03, OB03)
                CreateByteField (OBUF, 0x04, OB04)
