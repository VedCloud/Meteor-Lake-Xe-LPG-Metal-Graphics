                    CreateQWordField (NBU0, 0x16, NMA0)
                    CreateQWordField (NBU0, 0x26, NLE0)
                    NBA0 = NHAA /* \NHAA */
                    NMA0 = (NHAA + (NHLL - One))
                    NLE0 = NHLL /* \NHLL */
                }

