                        {
                            \PIN.ON (BRST)
                            Sleep (0x02)
                            ADBG ("WWAN PWR OFF")
                            \PIN.OFF (PWRG)
                            If (CondRefOf (WOFF))
                            {
                                WOFF = Timer
                            }
                        }

                        If (CondRefOf (WAKG))
                        {
                            If (((WAKG != Zero) && WKEN))
                            {
                                ADBG ("Enable WAKE")
                                SHPO (WAKG, Zero)
                            }
                            Else
                            {
                                ADBG ("Disable WAKE")
                                SHPO (WAKG, One)
                            }
