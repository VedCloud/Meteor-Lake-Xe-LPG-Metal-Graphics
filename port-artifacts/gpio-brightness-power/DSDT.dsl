                If (CondRefOf (RDF1))
                {
                    Name (BUF0, Buffer (0x05)
                    {
                         0x52, 0x54, 0x4B, 0x01, 0xFF                     // RTK..
                    })
                    BUF0 [0x04] = RDF1 /* External reference */
                    Return (BUF0) /* \_SB_.PC00.RP06.PXSX.RFUN.BUF0 */
