                    Local0 = BBM6 (0x05, SBDR)
                    CreateQWordField (Local0, 0x02, RSTE)
                    If ((RSTE != Zero))
                    {
                        Return (One)
                    }
                    Else
                    {
                        Return (Zero)
                    }
                }

                Return (Zero)
