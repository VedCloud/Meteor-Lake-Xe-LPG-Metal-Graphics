                    {
                        Switch (ToInteger (Arg2))
                        {
                            Case (Zero)
                            {
                                Return (Buffer (One)
                                {
                                     0x03                                             // .
                                })
                            }
                            Case (One)
                            {
                                If ((PNVM () && ((DLRM != Zero) && (S1G4 == One))))
                                {
                                    ADBG ("Enable DLRM for Storage")
                                    Return (One)
                                }
                                Else
                                {
                                    ADBG ("Disable DLRM for Storage")
                                    Return (Zero)
                                }
                            }

                        }
                    }
                }
            }

            If ((WIST () || ((WWEN != Zero) && (WWRP == SLOT))))
            {
                If (WIST ())
                {
                    If (EDSM (Arg0))
                    {
