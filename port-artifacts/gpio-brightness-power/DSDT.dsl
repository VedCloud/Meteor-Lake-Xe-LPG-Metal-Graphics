                             0x00                                             // .
                        }
                    Return (BBD3) /* \_SB_.AMW5.BBM2.BBD3 */
                }

                Local0 = (Arg0 * 0x18)
                Local0 += Arg1
                Local1 = DM08 (Local0, 0x08)
                CreateQWordField (Local1, Zero, BIAE)
                Local2 = DM08 (BIAE, 0x06)
                CreateWordField (Local2, 0x04, BIAL)
                Local3 = (BIAE + 0x06)
                Local4 = DM08 (Local3, BIAL)
                BBD3 [Zero] = Zero
                BBD3 [One] = BIAL /* \_SB_.AMW5.BBM2.BIAL */
                BBD3 [0x02] = Local4
