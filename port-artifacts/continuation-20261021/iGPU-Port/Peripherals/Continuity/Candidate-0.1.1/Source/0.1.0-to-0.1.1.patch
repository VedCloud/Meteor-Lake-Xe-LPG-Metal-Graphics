+    LAT_TX_PROP("ReclaimedWithoutResponse",missingResponse);LAT_TX_PROP("LastCookie",lastCookie);
+    LAT_TX_PROP("LastStatus",lastStatus);
+#undef LAT_TX_PROP
+}
