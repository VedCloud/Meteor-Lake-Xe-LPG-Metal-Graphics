+// Preserve native lifecycle semantics, and record which stage the Apple clients
+// actually reached. A created/attached object is not an operational AWDL radio.
+IO80211VirtualInterface *AirportItlwm::createVirtualInterface(ether_addr *address,unsigned int role)
+{
+    setProperty("LatitudeAWDLNativeCreateRole",(uint64_t)role,32);
+    auto result=super::createVirtualInterface(address,role);
+    setProperty("LatitudeAWDLNativeCreateSucceeded",result!=nullptr);
+    return result;
+}
+bool AirportItlwm::attachVirtualInterface(IO80211VirtualInterface **interface,ether_addr *address,unsigned int role,bool option)
+{
+    setProperty("LatitudeAWDLNativeAttachRole",(uint64_t)role,32);
+    bool result=super::attachVirtualInterface(interface,address,role,option);
+    setProperty("LatitudeAWDLNativeAttachSucceeded",result);
+    return result;
+}
+bool AirportItlwm::detachVirtualInterface(IO80211VirtualInterface *interface,bool option)
+{
+    bool result=super::detachVirtualInterface(interface,option);
+    setProperty("LatitudeAWDLNativeDetachSucceeded",result);
+    return result;
+}
+SInt32 AirportItlwm::enableVirtualInterface(IO80211VirtualInterface *interface)
+{
+    SInt32 result=super::enableVirtualInterface(interface);
+    setProperty("LatitudeAWDLNativeEnableResult",(uint64_t)(uint32_t)result,32);
+    return result;
+}
+SInt32 AirportItlwm::disableVirtualInterface(IO80211VirtualInterface *interface)
+{
+    SInt32 result=super::disableVirtualInterface(interface);
+    setProperty("LatitudeAWDLNativeDisableResult",(uint64_t)(uint32_t)result,32);
+    return result;
+}
